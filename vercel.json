{
  "rewrites": [
    { "source": "/api/send-code", "destination": "/api/account?action=send-code" },
    { "source": "/api/verify-code", "destination": "/api/account?action=verify-code" },
    { "source": "/api/logout", "destination": "/api/account?action=logout" },
    { "source": "/api/session", "destination": "/api/account?action=session" },
    { "source": "/api/check-pro", "destination": "/api/account?action=check-pro" },
    { "source": "/api/free-use", "destination": "/api/account?action=free-use" },
    { "source": "/api/photo-usage", "destination": "/api/account?action=photo-usage" },
    { "source": "/api/track", "destination": "/api/account?action=track" },
    { "source": "/api/stats", "destination": "/api/account?action=stats" }
  ],
  "crons": [
    { "path": "/api/telegram", "schedule": "0 17 * * *" }
  ],
  "redirects": [
    { "source": "/v/:id", "destination": "/?utm_source=contenido&c=:id", "permanent": false },
    { "source": "/ig", "destination": "/?utm_source=instagram", "permanent": false },
    { "source": "/yt", "destination": "/?utm_source=youtube", "permanent": false },
    { "source": "/tt", "destination": "/?utm_source=tiktok", "permanent": false },
    { "source": "/tg", "destination": "/?utm_source=telegram", "permanent": false },
    { "source": "/x", "destination": "/?utm_source=x", "permanent": false },
    { "source": "/dc", "destination": "/?utm_source=discord", "permanent": false },
    { "source": "/fb", "destination": "/?utm_source=facebook", "permanent": false },
    { "source": "/rd", "destination": "/?utm_source=reddit", "permanent": false },
    { "source": "/wa", "destination": "/?utm_source=whatsapp", "permanent": false }
  ]
}
